service aiserver /vendor/bin/unisoc_aiserver-main
    interface aidl vendor.sprd.hardware.aiserver.IAIService/default
    class hal
    user root
    group system media_rw sdcard_rw everybody cache

on boot
    mkdir /data/vendor/aimodel 0777 system system
    mkdir /data/vendor/aimodel/mnn 0777 system system
    mkdir /data/vendor/aimodel/uni 0777 system system
    mkdir /data/vendor/aimodel/demo_pic 0777 system system
    restorecon_recursive /mnt/ai_modelhub
    restorecon_recursive /data/vendor/aimodel

#on property:vold.emulated.volume.ready=1
