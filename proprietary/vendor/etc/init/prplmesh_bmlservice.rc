on boot
    mkdir /data/vendor/prplmesh 0770 system system
    mkdir /data/vendor/prplmesh/tmp 0770 system system
    mkdir /data/vendor/prplmesh/tmp/beerocks 0770 system system

service bml_service /vendor/bin/bml_service
    class hal
    user system
    group system wifi inet shell net_admin dhcp
    capabilities NET_ADMIN NET_BIND_SERVICE NET_RAW SETUID KILL
    interface aidl org.prplmesh.bmlservice.IBmlService/default
    oneshot
    disabled
