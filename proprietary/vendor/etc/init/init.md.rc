    chmod 760 /proc/mdbg/assert
    chmod 760 /proc/mdbg/wdtirq
    chmod 760 /proc/mdbg/at_cmd
    chmod 760 /proc/mdbg/loopcheck

# SIPC state files
    chmod 0444 /dev/mbox
    chmod 0444 /dev/sipc_smsg
    chmod 0444 /dev/sipc_smem
    chmod 0444 /dev/sipc_sbuf
    chmod 0444 /dev/sipc_sblock
    chmod 0444 /dev/sipx
