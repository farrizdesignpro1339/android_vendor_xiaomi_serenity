on boot

# device/sprd/qogirl6/module/thermal/main.rc
# SPDX-FileCopyrightText: 2016-2025 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on boot
	chown system system /sys/class/thermal/thermal_zone11/trip_point_0_temp
	chown system system /sys/class/thermal/thermal_zone11/trip_point_1_temp

	chown system system /sys/class/thermal/cooling_device0/max_freq
	chown system system /sys/class/thermal/cooling_device0/min_freq
	chown system system /sys/class/thermal/cooling_device1/max_freq
	chown system system /sys/class/thermal/cooling_device1/min_freq
	chown system system /sys/devices/system/cpu/cpufreq/policy0/bcl_max_freq
	chown system system /sys/devices/system/cpu/cpufreq/policy6/bcl_max_freq
	chown system system /sys/devices/system/cpu/cpufreq/policy0/thermald_max_freq
	chown system system /sys/devices/system/cpu/cpufreq/policy6/thermald_max_freq
	chown system system /sys/devices/system/cpu/cpu0/sprd_core_ctrl/bcl_max_cpus
	chown system system /sys/devices/system/cpu/cpu6/sprd_core_ctrl/bcl_max_cpus
	chown system system /sys/devices/system/cpu/cpu0/sprd_core_ctrl/thermald_max_cpus
	chown system system /sys/devices/system/cpu/cpu6/sprd_core_ctrl/thermald_max_cpus
	chown system system /sys/class/devfreq/23100000.gpu/thermald_max_freq
	chown system system /sys/class/devfreq/23100000.gpu/bcl_max_freq

	#for ipa of EngineerMode
	chown system system /sys/class/thermal/thermal_zone11/mode
	chmod 660 /sys/class/thermal/thermal_zone11/mode

on property:persist.sys.thermal.ipa=0
	write /sys/class/thermal/thermal_zone11/mode disabled

on property:persist.sys.thermal.ipa=1
	write /sys/class/thermal/thermal_zone11/mode enabled
# device/sprd/qogirl6/module/droidfw/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on property:sys.boot_completed=1
    # setup final cpuset
    write /dev/cpuset/top-app-high-perf/cpus 6-7
    write /dev/cpuset/background-level1/cpus 0-5
# device/sprd/vnd_others_mpool/module/vnd_others/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

# create 777 folder in prodnv; prodnv is a partition that is not affected by factory reset in unisoc.
on late-fs && property:ro.vendor.prodnv_path=*
    mkdir ${ro.vendor.prodnv_path}/productinfo/finstatus 0777 root root

on early-init
    chmod 644 /sys/devices/soc0/soc_manufacturer
    chmod 644 /sys/devices/soc0/soc_model
    chown root system /sys/devices/soc0/soc_manufacturer
    chown root system /sys/devices/soc0/soc_model
    setprop ro.boot.product.hardware.sku 0000000

on early-init && property:ro.kernel.version=*
    setprop ro.vendor.kernel.version ${ro.kernel.version}

# device/sprd/vnd_others_mpool/module/vnd_others/ts/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on property:vendor.all.modules.ready=1
    chmod 664 /sys/touchscreen/ts_suspend
    chmod 664 /sys/touchscreen/ts_irq_eb
    chown root system /sys/touchscreen/ts_suspend
    chown root system /sys/touchscreen/ts_irq_eb
# C3Z-X code for HQFEAT-335896 by p-tangzhilong1 at 20260702 start
    chmod 0664 /sys/class/power_supply/battery/screen_on
    chown root system /sys/class/power_supply/battery/screen_on
# C3Z-X code for HQFEAT-335896 by p-tangzhilong1 at 20260702 end
# device/sprd/vnd_others_mpool/module/vnd_others/fs/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on init
    mkdir /mnt/ai_modelhub 0770 root root

on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

on post-fs
    restorecon_recursive /blackbox
# device/sprd/vnd_others_mpool/module/vnd_others/io/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on init
    #set foreground io priority
    #
    mkdir /dev/blkio/foreground
    chown system system /dev/blkio/foreground
    chown system system /dev/blkio/foreground/tasks
    chown system system /dev/blkio/foreground/cgroup.procs
    chmod 0664 /dev/blkio/foreground/tasks
    chmod 0664 /dev/blkio/foreground/cgroup.procs
    write /dev/blkio/foreground/blkio.prio.class none-to-rt

    #set mq-deadline prio_aging_expire val
    #
    write /dev/sys/block/by-name/rootdisk/queue/iosched/prio_aging_expire 100000

on property:sys.boot_completed=1 && property:ro.vendor.ioscheduler.config=uniosched
    # for topio with emmc device
    #
    mkdir /dev/blkio/top
    chown system system /dev/blkio/top
    chown system system /dev/blkio/top/tasks
    chown system system /dev/blkio/top/cgroup.procs
    chmod 0664 /dev/blkio/top/tasks
    chmod 0664 /dev/blkio/top/cgroup.procs
    write /dev/blkio/top/blkio.prio.class none-to-rt
    write /dev/blkio/top/blkio.topio 1

    write /dev/sys/block/by-name/rootdisk/queue/scheduler uniosched
    write /dev/sys/block/by-name/rootdisk/queue/iosched/prio_aging_expire 100000


on property:sys.boot_completed=1 && property:ro.vendor.ioscheduler.config=bfq
    # set defalut ioscheduler for sda
    #
    write /dev/sys/block/by-name/rootdisk/queue/scheduler bfq
    write /dev/sys/block/by-name/rootdisk/queue/iosched/slice_idle 0

on property:ro.vendor.ioscheduler.config=bfq && property:vold.sdcard0.state=mounted
    #set sdcard bfq when enable bfq
    #
    write /sys/block/mmcblk1/queue/scheduler bfq

# device/sprd/vnd_generic_mpool/module/vendor/bsp/perf/main.rc
# SPDX-FileCopyrightText: 2016-2024 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on init
    export PERF_CONFIG /vendor/etc/perfconfig
    export PERF_BUILDID_DIR /data/local/tmp/.debug
# device/sprd/vnd_generic_mpool/module/vendor/audio/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on post-fs-data
    mkdir /data/vendor/local                   0751 root root
    mkdir /data/vendor/local/media             0770 audioserver system
    mkdir /data/vendor/local/media/audio_param 0770 audioserver audio
    mkdir /mnt/vendor/audio                    0770 audioserver audio

on post-fs-data && property:ro.vendor.prodnv_path="/mnt/vendor/prodnv"
    mkdir /mnt/vendor/prodnv/audio             0770 audioserver audio

on boot
    chown audioserver audio /proc/asound/sprdphonesc2730/asoc-sprd-debug
    chmod 660 /proc/asound/sprdphonesc2730/asoc-sprd-debug
# device/sprd/vnd_generic_mpool/module/vendor/display/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on early-init
    setprop ro.hardware.enhance "unisoc"

on early-boot
#for Display
    chmod 0660 /sys/class/display/dphy0/hop
    chmod 0660 /sys/class/display/dphy0/ssc
    chmod 0660 /sys/class/display/panel0/name
    chmod 666 /sys/class/display/dispc0/vsync_rate_report
    chmod 0660 /sys/class/display/dispc0/disable_flip
    chmod 0660 /sys/class/display/dispc0/bg_color
    chmod 0660 /sys/class/display/dispc0/refresh
    chmod 0660 /sys/class/display/dispc0/disable_flip
    chmod 0664 /sys/class/display/dispc0/irq_register
    chmod 0664 /sys/class/display/dispc0/irq_unregister
    chmod 0664 /sys/class/display/panel0/esd_check_enable
    chmod 0660 /sys/class/display/dsi0/dpms_mode
    chmod 0660 /sys/class/display/dsi1/dpms_mode
    chmod 0664 /sys/class/backlight/sprd_backlight/brightness
    chown cameraserver system /sys/class/display/dispc0/bg_color
    chown cameraserver system /sys/class/display/dispc0/refresh
    chown cameraserver system /sys/class/display/dispc0/disable_flip
    chown system system /sys/class/backlight/sprd_backlight/brightness
    chown system system /sys/class/display/dphy0/hop
    chown system system /sys/class/display/dphy0/ssc
    chown system system /sys/class/display/panel0/name
    chown system system /sys/class/display/panel0/resolution
    chown system system /sys/class/display/panel0/esd_check_enable
    chown system system /sys/class/display/dispc0/vsync_rate_report
    chown system system /sys/class/display/dispc0/disable_flip
    chown system system /sys/class/display/dispc0/dpu_version
    chown system system /sys/class/display/dispc0/irq_register
    chown system system /sys/class/display/dispc0/irq_unregister
    chown graphics system /sys/class/display/dispc0/vsync_rate_report
    chown system system /sys/class/display/dispc0/low_res_simu
    chown system system /sys/class/display/dsi0/dpms_mode
    chown system system /sys/class/display/dsi1/dpms_mode
    chmod 664 /sys/class/display/dispc0/PQ/slp
    chmod 664 /sys/class/display/dispc0/PQ/cm
    chmod 664 /sys/class/display/dispc0/PQ/gamma
    chmod 664 /sys/class/display/dispc0/PQ/hsv
    chmod 664 /sys/class/display/dispc0/PQ/epf
    chmod 664 /sys/class/display/dispc0/PQ/scl
    chmod 664 /sys/class/display/dispc0/PQ/enable
    chmod 664 /sys/class/display/dispc0/PQ/disable
    chmod 664 /sys/class/display/dispc0/PQ/enhance_mode
    chmod 664 /sys/class/display/dispc0/PQ/pq_enhance
    chown system system /sys/class/display/dispc0/PQ/slp
    chown system system /sys/class/display/dispc0/PQ/cm
    chown system system /sys/class/display/dispc0/PQ/gamma
    chown system system /sys/class/display/dispc0/PQ/hsv
    chown system system /sys/class/display/dispc0/PQ/epf
    chown system system /sys/class/display/dispc0/PQ/scl
    chown system system /sys/class/display/dispc0/PQ/enable
    chown system system /sys/class/display/dispc0/PQ/disable
    chown system system /sys/class/display/dispc0/PQ/enhance_mode
    chown system system /sys/class/display/dispc0/PQ/pq_enhance
    chown system system /sys/class/backlight/sprd_backlight/brightness
    chown system system /sys/class/backlight/sprd_backlight/max_brightness
    chown system system /sys/class/display/backlight/max_brightness

#lcd feature ++ start
on property:sys.display_hbm=0
    write /sys/class/display/panel0/hbm_mode 0
on property:sys.display_hbm=1
    write /sys/class/display/panel0/hbm_mode 1
    write /sys/class/backlight/sprd_backlight/brightness 2047
#lcd feature ++ end

#cabc feature start
on property:sys.display_cabc=0
    write /sys/class/display/panel0/panel_cabc_mode 0
on property:sys.display_cabc=1
    write /sys/class/display/panel0/panel_cabc_mode 1
on property:sys.display_cabc=2
    write /sys/class/display/panel0/panel_cabc_mode 2
on property:sys.display_cabc=3
    write /sys/class/display/panel0/panel_cabc_mode 3
#cabc feature end

on boot
#for display disable_flip file
    chown cameraserver system /sys/class/display/dispc0/disable_flip
#lcd for power optimization
    chown system system /sys/class/display/dispc0/frame_count
    chmod 0664 /sys/class/display/dispc0/frame_count

#hbm enable for udfps
    wait /sys/class/display/panel0/hbm_enable
    chmod 0664 /sys/class/display/panel0/hbm_enable
    chown system system /sys/class/display/panel0/hbm_enable

on fs
    #Allow others to read fb devices
    chmod 660 /dev/graphics/fb0
    chmod 660 /dev/fb0
    chmod 666 /dev/adf0
    chmod 666 /dev/adf-interface0.0
    chmod 666 /dev/adf-overlay-engine0.0

# device/sprd/vnd_generic_mpool/module/vendor/modem/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
