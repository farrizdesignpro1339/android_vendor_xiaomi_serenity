# device/sprd/vnd_generic_mpool/module/vendor/power/battery/battery.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on post-fs-data && property:ro.vendor.prodnv_path=*
    mkdir ${ro.vendor.prodnv_path}/battery 0771 system root
    mkdir ${ro.vendor.prodnv_path}/battery/calibration_data 0770 system root
    mkdir ${ro.vendor.prodnv_path}/battery/rbat_data 0771 root system

#for jeita
on property:persist.vendor.eng.jeita=0
    write /sys/class/power_supply/battery/charger.0/jeita_control 0

on property:persist.vendor.eng.jeita=1
    write /sys/class/power_supply/battery/charger.0/jeita_control 1

#for keep_awake
on property:persist.vendor.eng.keepawake=0
    write /sys/class/power_supply/battery/charger.0/keep_awake 0

on property:persist.vendor.eng.keepawake=1
    write /sys/class/power_supply/battery/charger.0/keep_awake 1

on early-boot
# chown for engineermode
    chown system system /sys/class/power_supply/battery/stop_charge
    chmod 0664 /sys/class/power_supply/battery/stop_charge
    chown root system /sys/class/power_supply/battery/charger.0/stop_charge
    chown root system /sys/class/power_supply/battery/charger.0/enable_power_path
    chmod 0664 /sys/class/power_supply/battery/charger.0/stop_charge
    chmod 0664 /sys/class/power_supply/battery/charger.0/enable_power_path
    chmod 660 /sys/class/power_supply/battery/charger.0/jeita_control
    chmod 660 /sys/class/power_supply/battery/charger.0/keep_awake
    chmod 0666 /sys/class/power_supply/sprdfgu/cc_test_cmd
    chmod 660 /sys/class/power_supply/battery/input_current_limit
    chmod 660 /sys/class/power_supply/battery/constant_charge_current
    chown system system /sys/class/power_supply/battery/charge_full_design
    chown system system /sys/class/power_supply/battery/capacity

# device/sprd/vnd_generic_mpool/module/vendor/power/charge/charge.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on charger
    load_persist_props

on post-fs-data && property:ro.vendor.prodnv_path=*
    mkdir ${ro.vendor.prodnv_path}/battery 0771 system root
    mkdir ${ro.vendor.prodnv_path}/battery/calibration_data 0770 system root

#C3Z-X code for HQFEAT-335895 by wanglicheng at 20260626 start
# add charge_logger service for dump charge message
service charge_logger /vendor/bin/charge_logger
    class last_start
    user system
    group system system wakelock
    disabled
    oneshot
    seclabel u:r:charge_logger:s0
on post-fs-data
    mkdir /data/vendor/charge_logger 0771 system system
    chmod 0644 /data/vendor/charge_logger/charge_logger_a.csv
    chown system system /data/vendor/charge_logger/charge_logger_a.csv
on property:sys.boot_completed=1
    #chmod 0660 /sys/class/power_supply/wireless/reverse_chg_mode
    mkdir /data/vendor/charge_logger 0771 system system
    start charge_logger
#run charge_logger in off-charge mode
on charger
    mkdir /data/vendor/charge_logger 0771 system system
    #chmod 0660 /sys/class/power_supply/wireless/reverse_chg_mode
    start charge_logger
#C3Z-X code for HQFEAT-335895 by wanglicheng at 20260626 end
# device/sprd/vnd_generic_mpool/module/vendor/sensor/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
