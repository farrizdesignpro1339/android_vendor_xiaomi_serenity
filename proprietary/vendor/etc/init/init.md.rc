    chown system root /dev/sipc_smsg
    chown system root /dev/sipc_smem
    chown system root /dev/sipc_sbuf
    chown system root /dev/sipc_sblock
    chown system root /dev/sipx
    chown system system /sys/devices/platform/soc/soc:ipa-apb/soc:ipa-apb:sipa-dele/sipa_dele_reset
