    chown system system /data/vendor/gnss/supl/supl.xml
    chown system system /data/vendor/gnss/supl/spirentroot.cer
    chown system system /data/vendor/gnss/lte/ext.eph
    chown system system /data/vendor/gnss/lte/jpleph.405
    chown system system /data/vendor/gnss/lte/raw.obs
    chown system system /data/vendor/gnss/gnss.log
    chown system system /data/vendor/gnss/nmea.log
    chown system system /mnt/vendor/tsx.dat
    chown system system /mnt/vendor/txdata.txt
    chown system system /data/vendor/gnss/FlashCfg.cg
    chmod 666 /data/vendor/gnss/bin/gnssmodem.bin
    chmod 666 /data/vendor/gnss/config/config.xml
    chmod 660 /data/vendor/gnss/supl/supl.xml
    chmod 660 /data/vendor/gnss/supl/spirentroot.cer
    chmod 666 /data/vendor/gnss/lte/ext.eph
    chmod 666 /data/vendor/gnss/lte/jpleph.405
    chmod 660 /data/vendor/gnss/lte/raw.obs
    chmod 666 /data/vendor/gnss/gnss.log
    chmod 666 /data/vendor/gnss/nmea.log
    chown system system /mnt/vendor/tsx.dat
    chown system system /mnt/vendor/txdata.txt
    chmod 666 /data/vendor/gnss/FlashCfg.cg

on post-fs-data && property:ro.vendor.prodnv_path=*
    chown system system ${ro.vendor.prodnv_path}/tsx.dat
    chown system system ${ro.vendor.prodnv_path}/txdata.txt
    chmod 774 ${ro.vendor.prodnv_path}/tsx.dat
    chmod 774 ${ro.vendor.prodnv_path}/txdata.txt

on boot
    wait /sys/class/misc/gnss_common_ctl/gnss_power_enable
    wait /sys/class/misc/gnss_common_ctl/gnss_dump
    wait /sys/class/misc/gnss_common_ctl/gnss_subsys

    chmod 220 /sys/class/misc/gnss_common_ctl/gnss_power_enable
    chmod 660 /sys/class/misc/gnss_common_ctl/gnss_dump
    chmod 660 /sys/class/misc/gnss_common_ctl/gnss_subsys
    chown system system /sys/class/misc/gnss_common_ctl/gnss_power_enable
    chown system system /sys/class/misc/gnss_common_ctl/gnss_dump
    chown system system /sys/class/misc/gnss_common_ctl/gnss_subsys

service gpsd /vendor/bin/gpsd
    class core
    user system
    group gps system shell inet net_raw wifi
# device/sprd/vnd_generic_mpool/module/vendor/performance/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

# Set sched_util_clamp_min_rt_default 0 after boot_completed
on property:sys.boot_completed=1
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0
    # setup final cpuset
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3

# Set hung-task check just for userdebug version
on property:sys.boot_completed=1 && property:ro.debuggable=1
    write /proc/sys/kernel/hung_task_timeout_secs 60
    write /proc/sys/kernel/hung_task_warnings 20

# device/sprd/vnd_generic_mpool/module/vendor/app/settings/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on post-fs
    chmod 0775 /mnt/vendor
    chown system system /mnt/vendor
# device/sprd/vnd_generic_mpool/module/vendor/app/gms/main.rc
#SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on early-init && property:ro.boot.ddrsize.range="[0,512)"
   setprop persist.sys.private_features.enable 0

on early-init && property:ro.boot.ddrsize.range="[512,1024)"
   setprop persist.sys.private_features.enable 0

on early-init && property:ro.boot.ddrsize.range="[1024,2048)"
   setprop persist.sys.private_features.enable 0

on early-init && property:ro.boot.ddrsize.range="[2048,3072)"
   setprop persist.sys.private_features.enable 0

on early-init && property:ro.boot.ddrsize.range="[3072,4096)"
   setprop persist.sys.private_features.enable 0

on early-init && property:ro.boot.ddrsize.range="[4096,5120)"
   setprop persist.sys.private_features.enable 1

on early-init && property:ro.boot.ddrsize.range="[5120,6144)"
   setprop persist.sys.private_features.enable 1

on early-init && property:ro.boot.ddrsize.range="[6144,)"
   setprop persist.sys.private_features.enable 1
# device/sprd/vnd_generic_mpool/module/vendor/debug/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on boot
#for sysdump
    chown system system /proc/sprd_sysdump
    chown system system /sys/module/sysdump/parameters/lba

on early-boot
    # ETB info file
    chown system system /dev/tmc_etb
    chmod 660 /dev/tmc_etb
    chmod 0660 /dev/sprd_bm
    chmod 0660 /dev/dmc_mpu
    chown system system /dev/sprd_bm
    chown system system /dev/dmc_mpu

on boot
    chmod 664 /sys/class/modem/serdes0/channel
    chmod 664 /sys/class/modem/serdes1/channel
    chown system /sys/class/modem/serdes0/channel
    chown system /sys/class/modem/serdes1/channel
    chmod 664 /sys/class/modem/serdes0/freq
    chmod 664 /sys/class/modem/serdes1/freq
    chown system /sys/class/modem/serdes0/freq
    chown system /sys/class/modem/serdes1/freq

service bugreport /system/bin/dumpstate -d -p -z -B \
        -o /data/data/com.android.shell/files/bugreports/bugreport
    user root
    class late_start
    disabled
    oneshot

#for logcat2kmsg
service logcat2kmsg /system/bin/logwrapper -k logcat
    user root
    group log
    seclabel u:r:dumpstate:s0
    disabled

on property:persist.vendor.logcat2kmsg=true
    start logcat2kmsg

on property:persist.vendor.logcat2kmsg=false
    stop logcat2kmsg
# device/sprd/vnd_generic_mpool/module/vendor/engpc/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on post-fs-data
#modify permission for voicetrigger dev
    chown system  audio /dev/rt5512
    chmod 660     /dev/rt5512
#modify for tof calibration
    chmod 666 /${ro.vendor.prodnv_path}/vl53l0_offset_calibration.file
    chmod 666 /${ro.vendor.prodnv_path}/vl53l0_xtak_calibration.file
#modify for ams calibration
    chmod 666 /${ro.vendor.prodnv_path}/productinfo/tcs3430_calibration.txt
    mkdir /data/vendor/local/englog 0777

# device/sprd/vnd_generic_mpool/module/vendor/net/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on early-init
    #set MEMLOCK resource limit 8M
    setrlimit 8 0x7fffff 0x7fffff

on boot
    write /proc/sys/net/core/rmem_max 8388608
    write /proc/sys/net/core/rmem_default 8388608
    #bug 713396 expand the wmem buffer for adb uplink test
    write /proc/sys/net/core/wmem_max 8388608
    write /proc/sys/net/core/wmem_default 2097152
    write /proc/sys/net/ipv4/tcp_limit_output_bytes 1310720
# device/sprd/vnd_generic_mpool/module/vendor/log/ylog/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on early-init
    mkdir /dev/socket/ylog 0755 system system
    mkdir /dev/socket/ylog_lite 0755 system system

on post-fs-data
    mkdir /data/vendor/ylog 0770 shell system
    mkdir /data/vendor/ylog_lite 0777
    mkdir /data/vendor/local/slogmodem 0770 shell system
    mkdir /data/vendor/local/mlogservice 0770 shell system
    mkdir /data/vendor/mlog 0777
    mkdir /data/vendor/mlog/lwpdump 0777
    mkdir /data/vendor/mlog/pm 0777
    write /data/vendor/mlog/ae.txt ""
    chmod 777 /data/vendor/mlog/ae.txt
    write /data/vendor/mlog/awb.txt ""
    chmod 777 /data/vendor/mlog/awb.txt
    write /data/vendor/mlog/smart.txt ""
    chmod 777 /data/vendor/mlog/smart.txt
    write /data/vendor/mlog/lsc.txt ""
    chmod 777 /data/vendor/mlog/lsc.txt
    write /data/vendor/mlog/pm.txt ""
    chmod 777 /data/vendor/mlog/pm.txt
    write /data/vendor/mlog/nr.txt ""
    chmod 777 /data/vendor/mlog/nr.txt
    write /data/vendor/mlog/hdr.txt ""
    chmod 777 /data/vendor/mlog/hdr.txt
    write /data/vendor/mlog/af.txt ""
    chmod 777 /data/vendor/mlog/af.txt

on property:persist.vendor.ylog_lite.enabled=1
    start vendor.ylog_lite

on property:persist.vendor.ylog_lite.enabled=0
    stop vendor.ylog_lite
# device/sprd/vnd_generic_mpool/module/vendor/art/mversion/go/go.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on early-init && property:ro.boot.ddrsize.range="[0,512)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 1.0
   setprop dalvik.vm.heapstartsize 5m
   setprop dalvik.vm.heapsize 32m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 2m
   setprop dalvik.vm.madvise-random true

on early-init && property:ro.boot.ddrsize.range="[512,1024)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 1.0
   setprop dalvik.vm.heapstartsize 5m
   setprop dalvik.vm.heapgrowthlimit 128m
   setprop dalvik.vm.heapsize 256m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 2m
   setprop dalvik.vm.madvise-random true

on early-init && property:ro.boot.ddrsize.range="[1024,2048)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 2.0
   setprop dalvik.vm.heapstartsize 8m
   setprop dalvik.vm.heapgrowthlimit 128m
   setprop dalvik.vm.heapsize 256m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 8m
   setprop dalvik.vm.madvise-random true

# According to the settings of the dalvik.vm.heap* properties in the go_defaults_common.prop file,
# the dalvik.vm.heap* properties of the go version are configured as "[1024,2048)".
on early-init && property:ro.boot.ddrsize.range="[2048,3072)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 2.0
   setprop dalvik.vm.heapstartsize 8m
   setprop dalvik.vm.heapgrowthlimit 128m
   setprop dalvik.vm.heapsize 256m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 8m
   setprop dalvik.vm.madvise-random true

on early-init && property:ro.boot.ddrsize.range="[3072,4096)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 2.0
   setprop dalvik.vm.heapstartsize 8m
   setprop dalvik.vm.heapgrowthlimit 128m
   setprop dalvik.vm.heapsize 256m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 8m
   setprop dalvik.vm.madvise-random true

on early-init && property:ro.boot.ddrsize.range="[4096,5120)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 2.0
   setprop dalvik.vm.heapstartsize 8m
   setprop dalvik.vm.heapgrowthlimit 128m
   setprop dalvik.vm.heapsize 256m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 8m
   setprop dalvik.vm.madvise-random true

on early-init && property:ro.boot.ddrsize.range="[5120,6144)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 2.0
   setprop dalvik.vm.heapstartsize 8m
   setprop dalvik.vm.heapgrowthlimit 128m
   setprop dalvik.vm.heapsize 256m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 8m
   setprop dalvik.vm.madvise-random true

on early-init && property:ro.boot.ddrsize.range="[6144,)"
   setprop dalvik.vm.foreground-heap-growth-multiplier 2.0
   setprop dalvik.vm.heapstartsize 8m
   setprop dalvik.vm.heapgrowthlimit 128m
   setprop dalvik.vm.heapsize 256m
   setprop dalvik.vm.heaptargetutilization 0.75
   setprop dalvik.vm.heapminfree 512k
   setprop dalvik.vm.heapmaxfree 8m
   setprop dalvik.vm.madvise-random true

#bug1946073 enlarge suspend timeout for huge iowait
on early-init && property:ro.build.type=userdebug
   setprop dalvik.vm.thread-suspend-timeout-ms 20000
   setprop dalvik.vm.finalizer-timeout-ms 20000

on early-init && property:persist.skynet.enable=true
   setprop dalvik.vm.thread-suspend-timeout-ms 90000
   setprop dalvik.vm.finalizer-timeout-ms 90000
# device/sprd/vnd_generic_mpool/module/vendor/fs/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on boot
# block I/O vm.dirty parameters
    chmod 644 /proc/reserve_space/black_list
    chmod 644 /proc/reserve_space/white_list
    chmod 644 /proc/reserve_space/black_list_comm
    chmod 640 /proc/reserve_space/white_list_comm
    chmod 644 /proc/reserve_space/app_guid
    write /proc/reserve_space/black_list "1001,1002,1005,1006,1012,1013,1022,1023,1024,1025,2000,9999,"
    write /proc/reserve_space/white_list "1061,10000,10023,10074,10075,"
    write /proc/reserve_space/black_list_comm "slog,ylog,"
    write /proc/reserve_space/white_list_comm "AndroidTestSuit,"
    write /proc/reserve_space/app_guid "10000"
    chown system root /proc/io_monitor/enable
    chown system root /proc/io_monitor/io_stat
    chown system root /proc/io_monitor/output_rows
    write /proc/fs/data_state/discard_enable 1
    chown system root /proc/unisoc_fsio/iowait_stat
    chown system root /proc/unisoc_fsio/f2fs_stat
    chown system root /proc/unisoc_fsio/iotrace
    chmod 444 /dev/unisoc_iotrace_mmap
    chmod 444 /dev/unisoc_iotrace_mmap2
    write /proc/unisoc_fsio/io_monitor_enable 1

on property:ro.vendor.prodnv_path=*
    mkdir ${ro.vendor.prodnv_path} 0775 system system

on property:persist.vendor.sprd_blk_debug=1
    insmod /vendor_dlkm/lib/modules/kprobe_filemap.ko
    write /proc/fs/data_state/iodebug_enable 1
    write /proc/unisoc_fsio/iowait_stat 1
    write /proc/unisoc_fsio/iowait_stat 2
    write /proc/unisoc_fsio/f2fs_stat 1
    write /proc/unisoc_fsio/f2fs_stat 2
    write /proc/unisoc_fsio/iotrace 2

on cali-fs
    restorecon_recursive /blackbox

on factorytest-fs
    restorecon_recursive /blackbox

on property:persist.vendor.sprd_cpu_usage_debug=1
   insmod /vendor_dlkm/lib/modules/sprd_cpu_usage.ko

on property:vold.sdcard0.state=mounted
    write /sys/block/mmcblk1/queue/read_ahead_kb 256

on shutdown
    write /proc/fs/data_state/discard_enable 0
# device/sprd/vnd_generic_mpool/module/vendor/ufs/main.rc
# SPDX-FileCopyrightText: 2016-2023 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0


service ufs_ffu /vendor/bin/ufs_ffu
	oneshot
	user root
	class main
	group root system

