# device/sprd/vnd_generic_mpool/module/vendor/wcn/main.rc
# SPDX-FileCopyrightText: 2016-2025 Unisoc (Shanghai) Technologies Co., Ltd
# SPDX-License-Identifier: LicenseRef-Unisoc-General-1.0

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

## Wi-Fi P2P adaptive iface
on property:persist.vendor.wifi.direct.interface=*
    setprop wifi.direct.interface ${persist.vendor.wifi.direct.interface}

## Wi-Fi 80211AX
on property:ro.vendor.wifi.ax_enabled=true
    setprop wifi.direct.interface p2p0
    setprop persist.vendor.wifi.direct.interface p2p0
    setprop wifi.aware.interface wifi_aware0
    setprop ro.vendor.wifi.sap.he_bss_color_disabled false
    setprop ro.vendor.wifi.ibss_enabled true

## Bluetooth Le Audio
on property:ro.vendor.bluetooth.leaudio=true
    setprop bluetooth.device.class_of_device "90,66,12"
    setprop bluetooth.profile.bap.broadcast.assist.enabled true
    setprop bluetooth.profile.bap.broadcast.source.enabled true
    setprop bluetooth.profile.bap.unicast.client.enabled true
    setprop bluetooth.profile.ccp.server.enabled true
    setprop bluetooth.profile.csip.set_coordinator.enabled true
    setprop bluetooth.profile.hap.client.enabled true
    setprop bluetooth.profile.mcp.server.enabled true
    setprop bluetooth.profile.vcp.controller.enabled true

## For VoWifi update rssi
on property:ro.boot.wcn_chip=*
    setprop ro.hardware.wcn ${ro.boot.wcn_chip}

## single software with multiple hardware
on property:ro.boot.wcn_chip=songshanw6dl
    setprop ro.vendor.wifi.ax_enabled true
    setprop ro.vendor.bluetooth.leaudio true
    setprop ro.vendor.wifi.mainline_supplicant true

on property:ro.boot.wcn_chip=songshanw6e
    setprop ro.vendor.wifi.ax_enabled true
    setprop ro.vendor.bluetooth.leaudio true
    setprop ro.vendor.wifi.mainline_supplicant true
# device/sprd/vnd_generic_mpool/module/vendor/wcn/gnss/main.rc
