service vendor.dcxsrv /vendor/bin/dcxsrv
    class core
    user root
    group root system radio shell net_bt_admin input audio wifi media camera
    oneshot

on property:vendor.ro.bootmode=cali
    start vendor.dcxsrv

on property:vendor.ro.bootmode=autotest
    start vendor.dcxsrv

on property:ro.bootmode=factorytest
    start vendor.dcxsrv

on cali-fs
    chmod 0775 /${ro.vendor.prodnv_path}
    chown system system /${ro.vendor.prodnv_path}
    mkdir /${ro.vendor.prodnv_path}/productinfo 0771 system root
