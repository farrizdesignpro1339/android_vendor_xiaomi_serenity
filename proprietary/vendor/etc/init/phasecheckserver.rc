service phasecheckserver /vendor/bin/phasecheckserver
    class main
    user system
    group system root
    disabled

on property:persist.sys.phasechecksrv.enabled=1
    start phasecheckserver

on property:persist.sys.phasechecksrv.enabled=0
    stop phasecheckserver