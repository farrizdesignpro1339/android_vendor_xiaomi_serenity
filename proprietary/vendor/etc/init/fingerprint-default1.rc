service vendor.fingerprint-default /vendor/bin/hw/android.hardware.biometrics.fingerprint-service
    class late_start
    user system
    group system input uhid
    capabilities WAKE_ALARM
    disabled

on property:ro.vendor.fps.support=true
    start vendor.fingerprint-default

#add for FP begin:
on post-fs
    insmod ${ro.vendor.ko.mount.point}/socko/silead_fp.ko
    insmod ${ro.vendor.ko.mount.point}/socko/goodix_fp.ko
on factorytest
    insmod ${ro.vendor.ko.mount.point}/socko/silead_fp.ko
    insmod ${ro.vendor.ko.mount.point}/socko/goodix_fp.ko
on boot
    chmod 660 /dev/silead_fp
    chmod 660 /dev/goodix_fp
    chown system system /dev/silead_fp
    chown system system /dev/goodix_fp
    mkdir /data/vendor/silead 0770 system system
    mkdir /data/vendor/fpdump 0770 system system
    setprop persist.vendor.sys.fp.dump_data 1
#add for FP end!
