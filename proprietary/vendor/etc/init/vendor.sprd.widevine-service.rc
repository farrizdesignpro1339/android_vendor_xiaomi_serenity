on property:ro.bootmode=cali
    start vendor.drm-widevine-hal-cali

service vendor.drm-widevine-hal-cali /apex/com.google.android.widevine/bin/hw/android.hardware.drm-service.widevine-rikers
    interface aidl android.hardware.drm.IDrmFactory/widevine
    class cali
    user media
    group media mediadrm drmrpc system

