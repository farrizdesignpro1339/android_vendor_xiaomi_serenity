<mbsconfig>
    <!--5g MBS switch-->
    <enable>false</enable>
    <ipnull>0.0.0.0</ipnull>
    <ipgroup>239.0.0.1</ipgroup>
    <ip16>10.1.2.16</ip16>
    <ip17>10.1.2.17</ip17>
</mbsconfig>
<selfrecovery>
    <!--network selfrecovery switch-->
    <enable>false</enable>
</selfrecovery>
<vipconfig>
    <!--vip service switch-->
    <enable>false</enable>
    <!--speed restrict(KB/s)-->
    <limit>512</limit>
    <!--foreground vip apps-->
    <fore>com.tencent.wemeet.app</fore>
    <fore>com.taobao.taobao</fore>
    <!--background limit apps-->
    <must>com.android.chrome</must>
    <must>org.zwanoo.android.speedtest</must>
    <!--white vip apps-->
    <white>com.tencent.mtt</white>
    <white>com.ss.android.ugc.aweme</white>
</vipconfig>
