# AR.695.001689.006144.016383--CpuInfo Collector
# Bug 2586718
service unisoc-cpuinfo /system/bin/dumpstate -c
    class main
    user system
    group system
    disabled
    oneshot

# AR.695.001095.003366.013407--Support delete corefile
# Bug 2585606
service deletecorefile /system/bin/dumpstate -C
    class main
    user system
    group system
    disabled
    oneshot
