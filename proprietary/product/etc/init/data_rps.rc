service vendor.rps_on /product/bin/data_rps.sh on
    user root
    group system root
    disabled
    oneshot

service vendor.rps_off /product/bin/data_rps.sh off
    user root
    group system root
    disabled
    oneshot

service vendor.sfp_on /product/bin/data_rps.sh sfp_on
    user root
    group system root
    disabled
    oneshot

service vendor.sfp_off /product/bin/data_rps.sh sfp_off
    user root
    group system root
    disabled
    oneshot

service vendor.lockfreq_on /product/bin/data_rps.sh lockfreq_on
    user root
    group system root
    disabled
    oneshot

service vendor.lockfreq_off /product/bin/data_rps.sh lockfreq_off
    user root
    group system root
    disabled
    oneshot

service vendor.rps_roc_m /product/bin/data_rps.sh roc_m
    user root
    group system root
    disabled
    oneshot

service vendor.rps_roc_h /product/bin/data_rps.sh roc_h
    user root
    group system root
    disabled
    oneshot


