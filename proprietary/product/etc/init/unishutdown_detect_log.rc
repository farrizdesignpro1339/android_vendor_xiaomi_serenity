on property:sys.boot_completed=1 && property:ro.debuggable=1
    setprop sys.feature.shutdown.detect.log boot_sucess

on property:sys.feature.shutdown.detect.log=boot_sucess
    chown root system /proc/shutdown_detect
    chmod 777 /product/bin/unishutdown_detect_log
    exec u:object_r:unishutdown_detect_log_exec:s0 system system -- /product/bin/unishutdown_detect_log

service unishutdown_detect_log /product/bin/unishutdown_detect_log
    class main
    oneshot

